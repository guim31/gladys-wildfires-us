  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-wildfires-us:1.0.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-wildfires-us/main/cover.png",
